Fix winebuild on 32-bit ARM hosts (armhf) with LLVM's integrated assembler.

Problem
-------
LLVM's integrated assembler mmaps the *whole* file for every `.incbin`
directive.  Wine's winebuild emits one `.incbin "<big>.res",offset,size`
per resource.  For dlls/shell32 there are 3082 resources in an 8.7 MB
shell32.res, i.e. 3082 mappings of 8.7 MB each.  On a 32-bit host the
~3 GB user address space is exhausted after ~450 mappings and clang
fails with a misleading error:

    error: Could not find incbin file '.../dlls/shell32/shell32.res'

The failure point is non-deterministic (depends on address space
layout), which makes it look like a race.

Fix
---
Write each resource's data to its own small temporary file and use a
plain `.incbin "<tmpfile>"` without offset/size.  The assembler then maps
only a few KB per resource.  Temp files live in winebuild's temp dir and
are removed on exit.

Applied to Wine 11.21; the same code is present in other versions.
Does not change the generated DLL, only how the resource blob is fed to
the assembler.

--- a/tools/winebuild/res32.c
+++ b/tools/winebuild/res32.c
@@ -22,10 +22,12 @@
 
 #include <assert.h>
 #include <ctype.h>
+#include <limits.h>
 #include <stdlib.h>
 #include <string.h>
 #include <stdarg.h>
 #include <stdio.h>
+#include <unistd.h>
 
 #include "build.h"
 
@@ -439,9 +441,21 @@
     i = 0;
     ARRAY_FOR_EACH( res, &spec->resources, struct resource )
     {
+        /* LLVM's integrated assembler mmaps the whole input file for every
+         * .incbin directive, so a large resource file with thousands of
+         * resources exhausts the 32-bit address space on ARM.  Write each
+         * resource to its own small file instead. */
+        char *name = make_temp_file( "res", ".bin" );
+        FILE *f = fopen( name, "wb" );
+
+        if (!f) fatal_error( "cannot create %s\n", name );
+        if (res->data_size && fwrite( res->data, 1, res->data_size, f ) != res->data_size)
+            fatal_error( "cannot write %s\n", name );
+        fclose( f );
+
         output( "\n\t.balign 4\n" );
         output( ".L__wine_spec_res_%d:\n", i++ );
-        output( "\t.incbin \"%s\",%d,%d\n", res->input_name, res->input_offset, res->data_size );
+        output( "\t.incbin \"%s\"\n", name );
     }
 
     if (!is_pe())
